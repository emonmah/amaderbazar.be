# ==============================================================================
# AMADER BAZAR (আমাদের বাজার) BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS (Required)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. MongoDB Atlas, Render Managed MongoDB, etc.)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/ecommerce_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://dbUser:strongPassword@cluster0.mongodb.net/ecommerce_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. REDIS CONFIGURATION (Optional - falls back to in-memory Redis if not set)
# ------------------------------------------------------------------------------
# Option A: Connection string (Recommended for Render Key-Value, Upstash, Redis Cloud)
REDIS_URL=rediss://default:password@your-redis-host.com:6379

# Option B: Individual host/port/password
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION SECRETS (Required in Production)
# ------------------------------------------------------------------------------
# Generate strong 64-character random strings (e.g. using 'openssl rand -hex 32')
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here_min_32_chars
JWT_REFRESH_EXPIRES_IN=604800

# ------------------------------------------------------------------------------
# 5. RENDER ANTI-SLEEP KEEP-ALIVE (Free Tier Heartbeat)
# ------------------------------------------------------------------------------
# Render automatically injects RENDER_EXTERNAL_URL in production (e.g. https://your-backend.onrender.com)
# If deploying elsewhere or testing, you can set it manually.
RENDER_EXTERNAL_URL=https://your-backend.onrender.com
KEEP_ALIVE_INTERVAL_MINUTES=10

# ------------------------------------------------------------------------------
# 6. TENANT & STORE CONFIGURATION
# ------------------------------------------------------------------------------
TENANT_MODE=SAAS
DEFAULT_TENANT_ID=tenant-fashion-001
ROOT_DOMAIN=platform.local
STOREFRONT_URL=https://your-storefront.vercel.app

# ------------------------------------------------------------------------------
# 7. RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_MAX=10000
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# 8. BANGLADESHI PAYMENT GATEWAYS (Optional in dev / sandbox)
# ------------------------------------------------------------------------------
# bKash Tokenized Checkout
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# SSLCommerz Payment Gateway
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASS=your_sslcommerz_store_password
SSLCOMMERZ_IS_SANDBOX=true

# Stripe (Optional International)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 9. BANGLADESHI COURIERS & LOGISTICS (Optional in dev / sandbox)
# ------------------------------------------------------------------------------
# Steadfast Courier (Cash on Delivery & Parcel Delivery)
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1

# Pathao Courier
PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret
PATHAO_USERNAME=your_pathao_username
PATHAO_PASSWORD=your_pathao_password
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
